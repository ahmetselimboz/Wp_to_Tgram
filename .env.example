# Telegram — @BotFather'dan bot oluştur, token'ı buraya yaz
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram chat ID — @userinfobot'a /start yazarak öğren
TELEGRAM_CHAT_ID=123456789

# Oturum dosyalarının saklanacağı dizin (Docker'da volume'a mount edilir)
AUTH_DIR=./data/auth

# QR kodunun kaydedileceği dizin (ilk bağlantıda)
DATA_DIR=./data

# Sohbetteyken bildirim: mesajı okursan Telegram'a gitmez (milisaniye). 0 = anında gönder
NOTIFY_DELAY_MS=15000
